# ── Voice detection engine ───────────────────────────────────────────────
# pretrained = wav2vec2 deepfake detector (optionally fine-tuned)  ← recommended
# model      = in-house Conformer (conformer_audio_model.keras)
# heuristic  = librosa MFCC/bandwidth fallback
VOICE_ENGINE=pretrained

# Used when VOICE_ENGINE=pretrained. A HuggingFace repo id (downloaded
# automatically — works out of the box) or a local path.
# Default = our fine-tuned Hebrew model, hosted on HuggingFace.
SPOOF_MODEL=uvarkina/safewawe-hebrew

# Only for VOICE_ENGINE=model. Set to 1 if the Conformer was retrained with
# retrain_model.py (output = P(AI)); leave 0 for the original shipped model.
MODEL_OUTPUT_IS_AI=1

# ── Twilio WhatsApp Sandbox (alerts) — optional ──────────────────────────
# Only needed for the family-notification feature; the detector runs without it.
# 1. Get them from https://console.twilio.com → Account → API keys
# 2. Activate the Sandbox: console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# 3. Send "join <your-keyword>" from the family phone to the Twilio Sandbox number
#    BEFORE the first alert — otherwise Twilio rejects it.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# Name of the person being called (appears in the alert text)
GUARD_CALL_VICTIM_NAME=אימא

# Family member's number in E.164 format (with "+")
GUARD_CALL_FAMILY_PHONE=+972537158722
